# Production environment files (Must never be committed)
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Production build artifacts
dist/
build/

# Logs and runtime files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid

# OS and temporary files
.DS_Store
.cache/
uploads/*
!uploads/.gitkeep
data/*
!data/.gitkeep
