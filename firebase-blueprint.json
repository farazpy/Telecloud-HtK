{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile information synchronized from Google Auth.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address."
        },
        "displayName": {
          "type": "string",
          "description": "User's full name."
        },
        "photoURL": {
          "type": "string",
          "description": "User's profile photo URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the user first signed in."
        }
      },
      "required": [
        "uid",
        "email"
      ]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "users",
      "description": "Collection of user profile documents."
    }
  }
}
